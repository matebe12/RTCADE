{
  "name": "RTCADE",
  "short_name": "RTCADE",
  "description": "브라우저에서 레트로 게임을 P2P 넷플레이로 즐기는 웹 애플리케이션",
  "lang": "ko",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0b1220",
  "theme_color": "#0b1220",
  "categories": ["games", "entertainment"],
  "handle_links": "preferred",
  "capture_links": "existing-client-navigate",
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },
  "icons": [
    {
      "src": "/pwa-icon-192.webp",
      "sizes": "192x192",
      "type": "image/webp",
      "purpose": "any"
    },
    {
      "src": "/pwa-icon-512.webp",
      "sizes": "512x512",
      "type": "image/webp",
      "purpose": "any"
    },
    {
      "src": "/pwa-icon-512-maskable.webp",
      "sizes": "512x512",
      "type": "image/webp",
      "purpose": "maskable"
    }
  ]
}
