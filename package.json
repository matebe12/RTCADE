{
  "name": "rtcade",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "server": "pnpm --filter @rtcade/server dev",
    "dev:all": "concurrently \"pnpm --filter @rtcade/web dev\" \"pnpm --filter @rtcade/server dev\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/mcp": "^0.0.78",
    "@playwright/test": "^1.62.0",
    "@types/pako": "^2.0.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "turbo": "^2.5.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0"
  }
}
